---
import { getCollection } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getMap } from "@/utils/getMap";
import { getPath } from "@/utils/getPath";
import { MAP_INTRO } from "@/data/map";
import { SITE } from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

const { lines, unmapped, startHere } = getMap(await getCollection("blog"));

const formatDate = (date: Date, withDay = true) =>
  dayjs(date)
    .tz(SITE.timezone)
    .format(withDay ? "YYYY.MM.DD" : "YYYY.MM");
---

<Layout
  title={`Map | ${SITE.title}`}
  description="按思路读 koukyo 的文章：创业经历、创业方法、财务与杠杆三条线。"
>
  <Header />
  <Main pageTitle="Map">
    <section id="overview" class="pb-10">
      <p class="leading-relaxed text-foreground/85">{MAP_INTRO}</p>

      <ul class="mt-6 space-y-2">
        {
          lines.map(line => (
            <li style={`--line:${line.color}`}>
              <a
                href={`#${line.id}`}
                class="group flex items-center gap-3 rounded-lg border border-border px-4 py-3 transition-colors hover:border-(--line)"
              >
                <span
                  aria-hidden="true"
                  class="h-1.5 w-8 shrink-0 rounded-full bg-(--line)"
                />
                <span class="shrink-0 font-medium group-hover:text-accent">
                  {line.name}
                </span>
                <span class="flex-1 truncate text-sm text-foreground/65 max-sm:hidden">
                  {line.question}
                </span>
                <span class="shrink-0 text-xs text-foreground/60 tabular-nums">
                  {line.stations.length} 站
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      startHere.length > 0 && (
        <section id="start-here" class="border-t border-border pt-10 pb-10">
          <h2 class="text-2xl font-semibold tracking-wide">从这里开始</h2>
          <p class="mt-2 text-sm text-foreground/65">第一次来，先读这几篇。</p>
          <ol class="mt-4 space-y-4">
            {startHere.map((post, i) => (
              <li class="flex gap-4">
                <span class="w-5 shrink-0 text-lg font-semibold text-accent tabular-nums">
                  {i + 1}
                </span>
                <div>
                  <a
                    href={getPath(post.id, post.filePath)}
                    class="font-medium text-accent decoration-dashed underline-offset-4 hover:underline"
                  >
                    {post.data.title}
                  </a>
                  <p class="mt-1 text-sm text-foreground/75">
                    {post.data.description}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      lines.map(line => (
        <section
          id={line.id}
          class="border-t border-border pt-10 pb-10"
          style={`--line:${line.color}`}
        >
          <div class="flex items-center gap-3">
            <span
              aria-hidden="true"
              class="h-7 w-1.5 shrink-0 rounded-full bg-(--line)"
            />
            <h2 class="text-2xl font-semibold tracking-wide">{line.name}</h2>
          </div>
          <p class="mt-3 text-lg font-medium">{line.question}</p>
          <p class="mt-2 leading-relaxed text-foreground/80">{line.intro}</p>
          <p class="mt-2 text-sm text-foreground/60 tabular-nums">
            {line.stations.length} 站 · 最近更新{" "}
            {formatDate(line.updated, false)}
          </p>

          <ol class="mt-6">
            {line.stations.map((station, i) => (
              <li class="relative ps-9 pb-8 last:pb-0">
                {i < line.stations.length - 1 && (
                  <span
                    aria-hidden="true"
                    class="absolute start-[7px] top-3 bottom-0 w-[3px] translate-y-1 bg-(--line)"
                  />
                )}
                <span
                  aria-hidden="true"
                  class:list={[
                    "absolute start-0 top-1.5 z-10 size-[17px] rounded-full border-[3px] bg-background",
                    station.transfers.length > 0
                      ? "border-foreground"
                      : "border-(--line)",
                  ]}
                />
                <a
                  href={station.href}
                  class="text-lg font-medium text-accent decoration-dashed underline-offset-4 hover:underline"
                >
                  {station.post.data.title}
                </a>
                <p class="mt-1 text-foreground/85">{station.takeaway}</p>
                <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-foreground/65">
                  <span class="rounded-full bg-muted/70 px-2 py-0.5">
                    {station.kind}
                  </span>
                  <time
                    class="tabular-nums"
                    datetime={station.post.data.pubDatetime.toISOString()}
                  >
                    {formatDate(station.post.data.pubDatetime)}
                  </time>
                  {station.transfers.map(transfer => (
                    <a
                      href={`#${transfer.id}`}
                      class="inline-flex items-center gap-1.5 rounded-full border border-border px-2 py-0.5 hover:border-accent hover:text-accent"
                    >
                      <span
                        aria-hidden="true"
                        class="size-2 rounded-full"
                        style={`background:${transfer.color}`}
                      />
                      换乘 {transfer.name}
                    </a>
                  ))}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    {
      unmapped.length > 0 && (
        <section id="unmapped" class="border-t border-border pt-10 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">还没归线</h2>
          <ul class="mt-4 space-y-2">
            {unmapped.map(post => (
              <li>
                <a
                  href={getPath(post.id, post.filePath)}
                  class="text-accent decoration-dashed underline-offset-4 hover:underline"
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </Main>
  <Footer />
</Layout>
