---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { getMap } from "@/utils/getMap";
import { getPath } from "@/utils/getPath";
import { MAP_INTRO } from "@/data/map";
import Newsletter from "@/components/Newsletter.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

dayjs.extend(utc);
dayjs.extend(timezone);

const posts = await getCollection("blog");

const recentPosts = getSortedPosts(posts);
const { lines } = getMap(posts);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        还在路上。
      </h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        硕士毕业后在日本漂了一年，发现没有真正适合自己干的事——那就自己创造一个。2025年夏天开始创业，磕磕绊绊走了不少弯路，但从来没有后悔过。这里记录我关于创业、财务规划和生活方式的经验与思考。
      </p>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      lines.length > 0 && (
        <section id="map" class="border-b border-border pt-12 pb-10">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-2xl font-semibold tracking-wide">Map</h2>
            <LinkButton href="/map" class="text-sm">
              查看完整 Map
              <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
            </LinkButton>
          </div>
          <p class="mt-3 leading-relaxed text-foreground/85">{MAP_INTRO}</p>
          <ul class="mt-8 space-y-6">
            {lines.map(line => (
              <li>
                <a
                  href={`/map#${line.id}`}
                  class="group grid grid-cols-[5.5rem_1fr] items-center gap-x-4 gap-y-1.5 sm:grid-cols-[5.5rem_10.5rem_1fr] sm:gap-x-6"
                >
                  <span class="font-medium group-hover:text-accent">
                    {line.name}
                  </span>
                  <span
                    aria-hidden="true"
                    class="flex items-center"
                    title={`${line.stations.length} 站`}
                  >
                    {line.stations.map((_, i) => (
                      <>
                        {i > 0 && (
                          <span class="h-0.5 w-7 bg-foreground/20 transition-colors group-hover:bg-accent" />
                        )}
                        <span class="size-2.5 rounded-full border-2 border-foreground/40 bg-background transition-colors group-hover:border-accent" />
                      </>
                    ))}
                  </span>
                  <span class="text-sm text-foreground/60 max-sm:col-start-2">
                    {line.question}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul class="mt-6 space-y-8">
            {recentPosts.slice(0, SITE.postPerIndex).map(post => (
              <li>
                <a
                  href={getPath(post.id, post.filePath)}
                  class="text-lg font-medium text-accent decoration-dashed underline-offset-4 hover:underline"
                >
                  {post.data.title}
                </a>
                <p class="mt-1.5 leading-relaxed text-foreground/75">
                  {post.data.description}
                </p>
                <time
                  class="mt-2 block text-xs text-foreground/60 tabular-nums"
                  datetime={post.data.pubDatetime.toISOString()}
                >
                  {dayjs(post.data.pubDatetime)
                    .tz(SITE.timezone)
                    .format("YYYY.MM.DD")}
                </time>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <Newsletter />

    <div class="my-8 text-center">
      <LinkButton href="/archives">
        Archives
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
