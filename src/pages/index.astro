---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { getPath } from "@/utils/getPath";
import Newsletter from "@/components/Newsletter.astro";
import TravellingsBadge from "@/components/TravellingsBadge.astro";
import FriendsBadge from "@/components/FriendsBadge.astro";
import { getSortedNotes, getNotePath, getNoteExcerpt } from "@/utils/notes";
import { formatNoteDate } from "@/utils/formatNoteDate";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

dayjs.extend(utc);
dayjs.extend(timezone);

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const recentNotes = (await getSortedNotes()).slice(0, 3);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        还在路上。
      </h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        硕士毕业后在日本漂了一年，发现没有真正适合自己干的事——那就自己创造一个。2025年夏天开始创业，磕磕绊绊走了不少弯路，但从来没有后悔过。这里记录我关于创业、财务规划和生活方式的经验与思考。
      </p>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
            <div class="mt-2 flex gap-2 self-start sm:ms-auto sm:mt-0 sm:self-auto">
              <FriendsBadge />
              <TravellingsBadge />
            </div>
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="border-b border-border pt-12 pb-10">
          <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
          <ul class="mt-6 space-y-8">
            {featuredPosts.map(post => (
              <li>
                <a
                  href={getPath(post.id, post.filePath)}
                  class="text-lg font-medium text-accent decoration-dashed underline-offset-4 hover:underline"
                >
                  {post.data.title}
                </a>
                <p class="mt-1.5 leading-relaxed text-foreground/75">
                  {post.data.description}
                </p>
                <time
                  class="mt-2 block text-xs text-foreground/60 tabular-nums"
                  datetime={post.data.pubDatetime.toISOString()}
                >
                  {dayjs(post.data.pubDatetime)
                    .tz(SITE.timezone)
                    .format("YYYY.MM.DD")}
                </time>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="border-b border-border pt-12 pb-10">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul class="mt-6 space-y-8">
            {recentPosts.slice(0, SITE.postPerIndex).map(post => (
              <li>
                <a
                  href={getPath(post.id, post.filePath)}
                  class="text-lg font-medium text-accent decoration-dashed underline-offset-4 hover:underline"
                >
                  {post.data.title}
                </a>
                <p class="mt-1.5 leading-relaxed text-foreground/75">
                  {post.data.description}
                </p>
                <time
                  class="mt-2 block text-xs text-foreground/60 tabular-nums"
                  datetime={post.data.pubDatetime.toISOString()}
                >
                  {dayjs(post.data.pubDatetime)
                    .tz(SITE.timezone)
                    .format("YYYY.MM.DD")}
                </time>
              </li>
            ))}
          </ul>
          <a
            href="/archives/"
            class="group mt-8 inline-flex items-center gap-1 text-sm text-foreground/70 hover:text-accent"
          >
            全部 Posts
            <IconArrowRight
              aria-hidden="true"
              class="size-4 transition-transform group-hover:translate-x-1 rtl:-rotate-180"
            />
          </a>
        </section>
      )
    }

    {
      recentNotes.length > 0 && (
        <section id="recent-notes" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Notes</h2>
          <ul class="mt-6 space-y-6">
            {recentNotes.map(note => (
              <li>
                <a
                  href={getNotePath(note.id)}
                  class="block leading-relaxed decoration-dashed underline-offset-4 hover:text-accent hover:underline"
                >
                  {getNoteExcerpt(note, 90)}
                </a>
                <time
                  class="mt-1.5 block text-xs text-foreground/60 tabular-nums"
                  datetime={note.data.pubDatetime.toISOString()}
                >
                  {formatNoteDate(note.data.pubDatetime)}
                </time>
              </li>
            ))}
          </ul>
          <a
            href="/notes/"
            class="group mt-8 inline-flex items-center gap-1 text-sm text-foreground/70 hover:text-accent"
          >
            全部 Notes
            <IconArrowRight
              aria-hidden="true"
              class="size-4 transition-transform group-hover:translate-x-1 rtl:-rotate-180"
            />
          </a>
        </section>
      )
    }

    <Newsletter />
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
