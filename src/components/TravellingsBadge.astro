---
import IconTrain from "@/assets/icons/IconTrain.svg";

type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<a
  href="https://www.travellings.cn/go.html"
  target="_blank"
  rel="noopener"
  title="开往-友链接力"
  class:list={[
    "group inline-flex items-center gap-1.5 rounded-full border border-foreground/20 px-2.5 py-0.5 text-sm whitespace-nowrap opacity-90 transition-colors hover:border-accent hover:text-accent",
    className,
  ]}
>
  <IconTrain
    class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
    aria-hidden="true"
  />
  <span>开往</span>
</a>
