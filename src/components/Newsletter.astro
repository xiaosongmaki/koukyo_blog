---
// Shared across the home page, post endings and About.
import NewsletterForm from "@/components/NewsletterForm.astro";
---

<section id="newsletter" class="newsletter" aria-labelledby="newsletter-title">
  <div class="newsletter-intro">
    <h2 id="newsletter-title">下一篇，寄给你。</h2>
    <p class="newsletter-copy">
      关于创业、财务自由，以及回国后的生活。 有新文章时，写信告诉你。
    </p>
  </div>
  <NewsletterForm source="section" />
</section>

<style>
  .newsletter {
    margin-block: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: start;
    gap: 2rem;
    padding-block: 2rem;
    color: var(--foreground);
  }
  .newsletter h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.025em;
  }
  .newsletter-copy {
    margin: 0.75rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.8;
  }
  @media (max-width: 639px) {
    .newsletter {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding-block: 1.75rem;
    }
    .newsletter-copy {
      max-width: 28rem;
    }
  }
</style>
