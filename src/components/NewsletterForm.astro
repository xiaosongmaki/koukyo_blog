---
// The email form shared by the newsletter section and the reading nudge.
// `source` is sent to Umami so signups can be compared by entry point.
type Props = {
  source: string;
  compact?: boolean;
};

const { source, compact = false } = Astro.props;
---

<form
  data-newsletter
  data-source={source}
  data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? ""}
  class:list={["newsletter-form", { compact }]}
>
  <div class="newsletter-fields">
    <label class="newsletter-email">
      <span class="sr-only">邮箱地址</span>
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        inputmode="email"
        maxlength="254"
        placeholder="你的邮箱地址"
      />
    </label>
    <button type="submit">订阅</button>
  </div>
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label
      >Website<input
        type="text"
        name="website"
        tabindex="-1"
        autocomplete="off"
      /></label
    >
  </div>
  <div data-turnstile class="mt-3" hidden></div>
  <p
    data-message
    class="mt-2 text-sm text-red-500 empty:hidden"
    role="alert"
    aria-live="polite"
  >
  </p>
  {!compact && <p class="newsletter-note">免费订阅，随时退订。</p>}
</form>

<script>
  import { navigate } from "astro:transitions/client";

  type Turnstile = {
    render: (el: HTMLElement, options: Record<string, unknown>) => string;
    getResponse: (id: string) => string | undefined;
    execute: (id: string) => void;
    reset: (id: string) => void;
    remove: (id: string) => void;
  };
  declare global {
    interface Window {
      turnstile?: Turnstile;
      __kyoTurnstileReady?: () => void;
    }
  }
  const widgets = new Map<HTMLFormElement, string>();
  function renderWidgets() {
    if (!window.turnstile) return;
    for (const form of document.querySelectorAll<HTMLFormElement>(
      "[data-newsletter]"
    )) {
      const slot = form.querySelector<HTMLElement>("[data-turnstile]");
      if (!slot || !form.dataset.sitekey || widgets.has(form)) continue;
      const btn = form.querySelector<HTMLButtonElement>("button")!;
      const msg = form.querySelector<HTMLElement>("[data-message]")!;
      const verificationFailed = () => {
        if (!form.dataset.verifying) return;
        delete form.dataset.verifying;
        btn.disabled = false;
        btn.textContent = "订阅";
        msg.textContent = "验证未完成，请重新点击订阅。";
        slot.hidden = true;
        const id = widgets.get(form);
        if (id) window.turnstile?.reset(id);
      };
      widgets.set(
        form,
        window.turnstile.render(slot, {
          sitekey: form.dataset.sitekey,
          appearance: "interaction-only",
          execution: "execute",
          callback: () => {
            if (!form.isConnected || !form.dataset.verifying) return;
            delete form.dataset.verifying;
            slot.hidden = true;
            btn.disabled = false;
            btn.textContent = "订阅";
            form.requestSubmit();
          },
          "error-callback": verificationFailed,
          "timeout-callback": verificationFailed,
          "expired-callback": verificationFailed,
          theme: "auto",
          language: "zh-cn",
          // The nudge form is hidden at render time, so its width reads as 0.
          size:
            form.clientWidth && form.clientWidth < 300 ? "compact" : "flexible",
        })
      );
    }
  }
  document.addEventListener("astro:before-swap", () => {
    for (const id of widgets.values()) window.turnstile?.remove(id);
    widgets.clear();
  });
  document.addEventListener("astro:page-load", () => {
    window.__kyoTurnstileReady = renderWidgets;
    if (
      document.querySelector(
        "[data-newsletter][data-sitekey]:not([data-sitekey=''])"
      ) &&
      !window.turnstile &&
      !document.getElementById("kyo-turnstile-script")
    ) {
      const script = document.createElement("script");
      script.id = "kyo-turnstile-script";
      script.src =
        "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__kyoTurnstileReady";
      script.async = true;
      document.head.appendChild(script);
    }
    renderWidgets();
    for (const form of document.querySelectorAll<HTMLFormElement>(
      "[data-newsletter]"
    )) {
      if (form.dataset.bound) continue;
      form.dataset.bound = "true";
      const msg = form.querySelector<HTMLElement>("[data-message]")!;
      form.addEventListener("submit", async e => {
        e.preventDefault();
        const email = new FormData(form).get("email") as string;
        const btn = form.querySelector("button") as HTMLButtonElement;
        if (btn.disabled) return;

        const widgetId = widgets.get(form);
        const token = widgetId ? window.turnstile?.getResponse(widgetId) : "";
        if (form.dataset.sitekey && !token) {
          if (!widgetId || !window.turnstile) {
            msg.textContent = "验证正在加载，请稍后重试。";
            return;
          }
          msg.textContent = "";
          form.dataset.verifying = "true";
          btn.disabled = true;
          btn.textContent = "验证中…";
          form.querySelector<HTMLElement>("[data-turnstile]")!.hidden = false;
          window.turnstile.execute(widgetId);
          return;
        }
        btn.disabled = true;
        btn.textContent = "提交中...";
        msg.textContent = "";

        try {
          const res = await fetch("/api/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email,
              token,
              website: new FormData(form).get("website"),
            }),
          });
          const data = await res.json();

          if (res.ok) {
            // Identify subscriber and track event in Umami
            window.umami?.identify(email);
            window.umami?.track("newsletter-subscribe", {
              source: form.dataset.source,
            });
            // The reading nudge checks this so subscribers never see it
            try {
              localStorage.setItem("kyo-subscriber", "1");
            } catch {
              // Storage can be blocked; the nudge then falls back to its own cooldown
            }
            // /thanks reads this to offer one-click signups for other newsletters
            sessionStorage.setItem(
              "kyo-subscribed",
              JSON.stringify({
                email,
                token: data.token,
                from: location.pathname,
              })
            );
            await navigate("/thanks/");
            return;
          }
          msg.textContent = data.error || "订阅失败，请稍后再试。";
          msg.className = "mt-2 text-sm text-red-500";
        } catch {
          msg.textContent = "网络错误，请稍后再试。";
          msg.className = "mt-2 text-sm text-red-500";
        } finally {
          if (widgetId && widgets.get(form) === widgetId)
            window.turnstile?.reset(widgetId);
          btn.disabled = false;
          btn.textContent = "订阅";
        }
      });
    }
  });
</script>

<style>
  .newsletter-fields {
    display: flex;
    gap: 0;
    border: 1px solid
      color-mix(in srgb, var(--foreground) 30%, var(--background));
    border-radius: 4px;
    padding: 0.25rem;
    background: var(--background);
  }
  .newsletter-email {
    flex: 1;
    min-width: 0;
  }
  .newsletter-form input[type="email"] {
    width: 100%;
    height: 2.75rem;
    padding: 0.625rem 0.75rem;
    border: 0;
    border-radius: 0;
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    font-size: 1rem;
  }
  .newsletter-form input::placeholder {
    color: color-mix(in srgb, var(--foreground) 60%, var(--background));
  }
  .newsletter-form button {
    height: 2.75rem;
    flex-shrink: 0;
    padding-inline: 1.125rem;
    border: 0;
    border-radius: 2px;
    background: var(--foreground);
    color: var(--background);
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    transition:
      opacity 150ms,
      transform 150ms;
  }
  .newsletter-form button:hover {
    opacity: 0.85;
  }
  .newsletter-form button:active {
    transform: translateY(1px);
  }
  .newsletter-form button:disabled {
    opacity: 0.5;
    cursor: wait;
  }
  .newsletter-form input:focus-visible,
  .newsletter-form button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .newsletter-form.compact input[type="email"],
  .newsletter-form.compact button {
    height: 2.5rem;
    font-size: 0.9375rem;
  }
  .newsletter-form.compact button {
    padding-inline: 1rem;
  }
  .newsletter-note {
    margin: 0.625rem 0 0;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--foreground) 70%, var(--background));
  }
  @media (prefers-reduced-motion: reduce) {
    .newsletter-form button {
      transition: none;
      transform: none;
    }
  }
</style>
