---
import IconUsers from "@/assets/icons/IconUsers.svg";

type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<a
  href="/friends/"
  title="友链"
  class:list={[
    "group inline-flex items-center gap-1.5 rounded-full border border-foreground/20 px-2.5 py-0.5 text-sm whitespace-nowrap opacity-90 transition-colors hover:border-accent hover:text-accent",
    className,
  ]}
>
  <IconUsers
    class="size-4 transition-transform duration-300 group-hover:scale-110"
    aria-hidden="true"
  />
  <span>友链</span>
</a>
